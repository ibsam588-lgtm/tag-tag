default_platform(:android)

platform :android do
  desc "Upload the signed Android App Bundle to Google Play internal testing"
  lane :internal do
    package_name = ENV.fetch("GOOGLE_PLAY_PACKAGE_NAME", "com.tagtag.playgroundblitz")
    track = ENV.fetch("GOOGLE_PLAY_TRACK", "internal")
    release_status = ENV.fetch("GOOGLE_PLAY_RELEASE_STATUS", "completed")
    aab_path = ENV.fetch(
      "ANDROID_AAB_PATH",
      "build/app/outputs/bundle/release/app-release.aab"
    )
    json_key = ENV.fetch(
      "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH",
      "google-play-service-account.json"
    )

    UI.user_error!("Missing Android App Bundle at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Missing Google Play service account JSON at #{json_key}") unless File.exist?(json_key)

    upload_to_play_store(
      package_name: package_name,
      track: track,
      release_status: release_status,
      aab: aab_path,
      json_key: json_key,
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end
end
